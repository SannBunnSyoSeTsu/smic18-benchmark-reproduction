XVCO_LOW (0 iref_LOW vctrl vdd_LOW outp_LOW outn_LOW) lc_vco_2ghz
CLP_LOW (outp_LOW 0) capacitor c=10f
CLN_LOW (outn_LOW 0) capacitor c=10f
ic outp_LOW=0.61 outn_LOW=0.59
save vdd_LOW iref_LOW outp_LOW outn_LOW VDD_LOW:p XVCO_LOW.tankct XVCO_LOW.pbu XVCO_LOW.pcas XVCO_LOW.vbias XVCO_LOW.varp XVCO_LOW.varn XVCO_LOW.vrefvar XVCO_LOW.rout
VDD_HIGH (vdd_HIGH 0) vsource dc=1.98
IREF_HIGH (iref_HIGH 0) isource dc=50u
XVCO_HIGH (0 iref_HIGH vctrl vdd_HIGH outp_HIGH outn_HIGH) lc_vco_2ghz
CLP_HIGH (outp_HIGH 0) capacitor c=10f
CLN_HIGH (outn_HIGH 0) capacitor c=10f
ic outp_HIGH=0.61 outn_HIGH=0.59
save vdd_HIGH iref_HIGH outp_HIGH outn_HIGH VDD_HIGH:p XVCO_HIGH.tankct XVCO_HIGH.pbu XVCO_HIGH.pcas XVCO_HIGH.vbias XVCO_HIGH.varp XVCO_HIGH.varn XVCO_HIGH.vrefvar XVCO_HIGH.rout
