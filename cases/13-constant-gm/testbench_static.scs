save X.MB2:ids X.MB2:gm X.MB2:gmbs X.MB2:gds X.MB2:vgs X.MB2:vds X.MB2:vdsat X.MB2:region
save X.MP1:ids X.MP1:gm X.MP1:gmbs X.MP1:gds X.MP1:vgs X.MP1:vds X.MP1:vdsat X.MP1:region
save X.MP2:ids X.MP2:gm X.MP2:gmbs X.MP2:gds X.MP2:vgs X.MP2:vds X.MP2:vdsat X.MP2:region
save X.MTAIL:ids X.MTAIL:gm X.MTAIL:gmbs X.MTAIL:gds X.MTAIL:vgs X.MTAIL:vds X.MTAIL:vdsat X.MTAIL:region
save X.MINP:ids X.MINP:gm X.MINP:gmbs X.MINP:gds X.MINP:vgs X.MINP:vds X.MINP:vdsat X.MINP:region
save X.MINN:ids X.MINN:gm X.MINN:gmbs X.MINN:gds X.MINN:vgs X.MINN:vds X.MINN:vdsat X.MINN:region
