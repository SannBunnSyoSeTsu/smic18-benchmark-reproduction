simulator lang=spectre
global 0
include "/home/IC/Tech/smic_018mmrf-OA/SMIC_018_MMRF/models/spectre/ms018_v1p7_spe.lib" section=tt
include "/home/IC/CodeX/smic18_benchmark_repro/cases/13-constant-gm/circuit.scs"
simulatorOptions options temp=27 tnom=27 reltol=1e-6 vabstol=1e-9 iabstol=1e-15
saveOptions options save=selected
parameters vdtest=0
VDD (vdd 0) vsource dc=1.8
IREF (vdd iref) isource dc=50u
VCM (cma 0) vsource dc=.95
VD (vd 0) vsource dc=vdtest mag=1
EINP (vinp cma vd 0) vcvs gain=.5
EINN (vinn cma vd 0) vcvs gain=-.5
X (0 iref vdd vinp vinn voutp voutn) cgm_amp
CLP (voutp 0) capacitor c=500f
CLN (voutn 0) capacitor c=500f
save vdd iref cma vd vinp vinn voutp voutn VDD:p X.nb X.nc X.rb2 X.tail
save X.MREF:ids X.MREF:gm X.MREF:gmbs X.MREF:gds X.MREF:vgs X.MREF:vds X.MREF:vdsat X.MREF:region
